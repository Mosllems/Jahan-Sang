# Copy this file to .env and fill in the values.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# With docker compose, the database host is the service name "db".
DATABASE_NAME=jahan_sang
DATABASE_USER=jahan_sang
DATABASE_PASSWORD=change-me
DATABASE_HOST=db
DATABASE_PORT=5432

# Optional: chat widget webhook (n8n). Leave empty to disable.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TIMEOUT=10
